# PostgreSQL Zugangsdaten (für lokale Entwicklung; in Produktion ändern!)
POSTGRES_USER=rechnung
POSTGRES_PASSWORD=rechnung_pw
POSTGRES_DB=rechnung

# Port, auf dem die Web-App erreichbar ist
WEB_PORT=8000

# Login: 3 Benutzer (Format user:passwort,...) – nur beim ERSTEN Start in die DB übernommen
APP_USERS=anna:passwort,bernd:passwort,clara:passwort
# Admin-Account (kann Benutzer verwalten) – nur beim ersten Start angelegt
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Geheimnis zum Signieren der Login-Sitzung (in Produktion unbedingt ändern!)
SESSION_SECRET=bitte-in-produktion-aendern-1234567890

# E-Mail-Versand über MailHog (Testserver, kein echter Versand).
# Für echten Versand in Produktion: SMTP_HOST/PORT auf den echten Mail-
# Provider setzen, SMTP_USER/SMTP_PASSWORD eintragen und SMTP_USE_TLS=true
# setzen (siehe scripts/setup-prod.sh).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=rechnung@example.com
MAILHOG_UI_PORT=8025

# Reverse-Proxy (rechnungen.localhost / mail.localhost)
PROXY_PORT=80

# --- Sicherheit ------------------------------------------------------------
# Secure-Flag für Sitzungs- und CSRF-Cookie. true, sobald die App nur noch
# über HTTPS erreichbar ist (setzt scripts/setup-prod.sh automatisch).
SESSION_HTTPS_ONLY=false
# Lebensdauer der Anmeldung in Sekunden (Standard: 12 Stunden)
SESSION_MAX_AGE=43200
# CSRF-Schutz für alle schreibenden Requests (nur zum Debuggen abschalten)
CSRF_ENABLED=true
# Rate-Limit je IP: Anzahl Requests pro Zeitfenster (Sekunden). 0 = aus.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=60
# Zusätzliches, strengeres Limit für POST /login
RATE_LIMIT_LOGIN=20
RATE_LIMIT_LOGIN_WINDOW=300
# HSTS-Header (wirkt nur bei HTTPS-Zugriff)
HSTS_ENABLED=true
# Log-Level der Anwendung: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Monitoring / Alarme ---------------------------------------------------
# Kennzahlen gibt es immer unter /api/admin/metrics (nur Admins). Alarm-Mails
# an die Firmen-E-Mail aus den Firmendaten sind standardmäßig aus.
ALERTS_ENABLED=false
# Schwellen im Beobachtungsfenster (Sekunden)
ALERT_ERROR_THRESHOLD=10
ALERT_LOGIN_THRESHOLD=20
ALERT_WINDOW=300
# Alarm, wenn das jüngste Backup älter ist (Stunden, 0 = Prüfung aus)
ALERT_BACKUP_MAX_AGE_HOURS=36
# Dieselbe Alarmart höchstens einmal pro Sperrfrist (Sekunden)
ALERT_COOLDOWN=3600
# Ab dieser Antwortzeit gilt ein Request als langsam (Sekunden)
SLOW_REQUEST_SECONDS=2

# --- Response-Cache ---------------------------------------------------------
# Hält Dashboard-Kennzahlen und Auswertungen kurz im Prozessspeicher vor
# (siehe backend/app/cache.py). CACHE_ENABLED=false schaltet es ganz ab.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# --- Dienstbenutzer --------------------------------------------------------
# UID/GID, unter der der web-Container läuft. Wird von scripts/setup-test.sh
# und scripts/setup-prod.sh auf den Host-Benutzer `rechnung` gesetzt.
APP_UID=10001
APP_GID=10001
